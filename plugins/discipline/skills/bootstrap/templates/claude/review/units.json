{
  "_comment": "Review units for the review-loop workflow (ADAPT: replace the example units with your repository's). The 'lenses' list is written by `discipline lenses apply` from .agents/profile.json; don't edit it by hand. Each unit is reviewed by the listed lenses; a (unit, lens) pair is re-reviewed only when its content hash changes. 'context' lists, per lens, files outside the unit whose changes also make that lens stale (e.g. the API contract for the contracts lens). Order = priority for never-reviewed units: put security-sensitive units first. Globs are fnmatch patterns on repo-relative paths ('*' matches within one path segment, '**' across segments). 'exclude' wins over 'include'. Every file under 'roots' must belong to exactly one unit (discipline check fails otherwise). Generated files and build output go in globalExclude; lockfiles do not: they belong to the dependencies unit, so a dependency change is reviewed.",
  "lenses": [
    "security",
    "behaviour",
    "tests",
    "architecture",
    "duplication",
    "performance",
    "supply-chain",
    "contracts",
    "ai",
    "localisation"
  ],
  "globalExclude": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/*.pyc",
    ".claude/review/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.png",
    "**/*.svg"
  ],
  "roots": [
    "src/",
    "tests/",
    "api/",
    "scripts/",
    ".github/",
    "Makefile",
    "Dockerfile",
    "package.json",
    "package-lock.json",
    "prompts/",
    "evals/"
  ],
  "units": [
    {
      "id": "auth",
      "include": [
        "src/auth/**",
        "tests/auth/**"
      ],
      "lenses": [
        "security",
        "behaviour",
        "tests",
        "architecture",
        "duplication",
        "performance",
        "contracts"
      ],
      "context": {
        "contracts": [
          "api/**"
        ]
      }
    },
    {
      "id": "dependencies",
      "include": [
        "package.json",
        "package-lock.json",
        "Dockerfile",
        ".github/**"
      ],
      "lenses": [
        "supply-chain",
        "security"
      ]
    },
    {
      "id": "core",
      "include": [
        "src/**",
        "tests/**"
      ],
      "exclude": [
        "src/auth/**",
        "tests/auth/**",
        "src/ai/**",
        "tests/ai/**"
      ],
      "lenses": [
        "security",
        "behaviour",
        "tests",
        "architecture",
        "duplication",
        "performance",
        "contracts",
        "localisation"
      ],
      "context": {
        "contracts": [
          "api/**"
        ]
      }
    },
    {
      "id": "ai",
      "include": [
        "src/ai/**",
        "tests/ai/**",
        "prompts/**",
        "evals/**"
      ],
      "lenses": [
        "ai",
        "security",
        "behaviour",
        "tests",
        "architecture"
      ]
    },
    {
      "id": "api-contract",
      "include": [
        "api/**"
      ],
      "lenses": [
        "contracts",
        "architecture"
      ]
    },
    {
      "id": "infra",
      "include": [
        "scripts/**",
        "Makefile"
      ],
      "lenses": [
        "security",
        "architecture",
        "duplication"
      ]
    }
  ]
}
