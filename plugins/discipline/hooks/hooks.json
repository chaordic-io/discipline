        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/readonly_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
